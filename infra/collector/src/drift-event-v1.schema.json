{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drift-thesis.example/schemas/drift-event-v1.schema.json",
  "title": "DriftEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "application", "revision", "t_detect", "reconciled_at", "received_at", "resources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "minLength": 64, "maxLength": 64},
    "event_type": {"const": "configuration_drift_detected"},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace"],
      "properties": {
        "name": {"const": "online-boutique"},
        "namespace": {"const": "online-boutique"}
      }
    },
    "revision": {"type": "string", "minLength": 1},
    "t_detect": {"type": "string", "format": "date-time"},
    "reconciled_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "version", "kind", "namespace", "name", "status", "live_state", "target_state", "diff"],
        "properties": {
          "group": {"type": "string"},
          "version": {"type": "string", "minLength": 1},
          "kind": {"enum": ["Deployment", "Service", "Role", "RoleBinding", "NetworkPolicy"]},
          "namespace": {"const": "online-boutique"},
          "name": {"type": "string", "minLength": 1},
          "status": {"const": "OutOfSync"},
          "health": {"type": ["object", "null"]},
          "live_state": {"type": ["object", "null"]},
          "target_state": {"type": ["object", "null"]},
          "diff": {"type": ["object", "array", "string", "null"]}
        }
      }
    }
  }
}
