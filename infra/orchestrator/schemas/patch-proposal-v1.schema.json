{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drift-thesis.example/schemas/patch-proposal-v1.schema.json",
  "title": "GitOps patch proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "classification", "summary", "patch", "files", "provenance"],
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "drift_class", "intent", "justification", "confidence", "review_required", "evidence_refs", "provenance"],
      "properties": {
        "severity": {"type": "integer", "enum": [0, 1, 2, 3]},
        "drift_class": {"type": "string", "enum": ["benign", "operational", "critical"]},
        "intent": {"type": "string", "enum": ["intentional-benign", "unintended", "malicious"]},
        "justification": {"type": "string", "minLength": 1, "maxLength": 2000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "review_required": {"type": "boolean"},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 200},
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 20
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_id", "prompt_version", "prompt_sha256", "temperature"],
          "properties": {
            "model_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "prompt_version": {"type": "string", "pattern": "^classify_v[0-9]+$"},
            "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "temperature": {"const": 0}
          }
        }
      }
    }
  },
  "properties": {
    "decision": {"type": "string", "enum": ["revert_to_git", "accept_live_into_git", "escalate"]},
    "classification": {"$ref": "#/$defs/classification"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "patch": {"type": "string", "maxLength": 128000},
    "files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 256},
      "uniqueItems": true,
      "maxItems": 20
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "prompt_version", "prompt_sha256", "temperature"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "prompt_version": {"type": "string", "pattern": "^patch_v[0-9]+$"},
        "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "temperature": {"const": 0}
      }
    }
  }
}
